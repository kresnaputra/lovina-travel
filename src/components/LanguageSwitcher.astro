---
import { languagePair } from '../data/locales';
const pair = languagePair(Astro.url.pathname);
---
{pair && <nav class="language-switcher" aria-label={pair.isIndonesian ? 'Pilih bahasa' : 'Choose language'}>
  <a href={pair.en} lang="en" hreflang="en" aria-current={!pair.isIndonesian ? 'page' : undefined}>EN<span class="language-name"> English</span></a>
  <span aria-hidden="true">/</span>
  <a href={pair.id} lang="id" hreflang="id" aria-current={pair.isIndonesian ? 'page' : undefined}>ID<span class="language-name"> Indonesia</span></a>
</nav>}
<style>
  .language-switcher{position:fixed;z-index:60;right:1rem;bottom:1rem;display:flex;align-items:center;gap:.45rem;border:1px solid var(--line);border-radius:99px;padding:.3rem .45rem;background:var(--paper);color:var(--ink);box-shadow:0 4px 20px #15383b12;font-size:.7rem}
  a{display:inline-flex;align-items:center;min-height:38px;padding:.25rem .6rem;border-radius:99px}.language-name{margin-left:.25rem}a[aria-current]{background:var(--ink);color:white}a:hover{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:600px){.language-name{display:none}.language-switcher{left:1rem;right:auto}}
</style>
