---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { business } from '../../data/business';
import { indonesianPages, indonesiaUpdated, idPath, type LocalPage } from '../../data/indonesian';
import { ArrowRight, ArrowUpRight } from 'lucide-astro';
export function getStaticPaths() {
  return indonesianPages.map(page => ({ params: { path: page.path === '/' ? undefined : page.path.replace(/^\//, '').replace(/\/$/, '') }, props: { page } }));
}
interface Props { page: LocalPage }
const { page } = Astro.props;
const home = page.kind === 'home';
const article = page.kind === 'article';
const canonical = new URL(idPath(page.path).replace(/\/$/, ''), Astro.site).href;
const quote = `https://wa.me/6281999966044?text=${encodeURIComponent(`Halo Bu Ayu, saya ingin bertanya tentang ${page.kind === 'service' ? page.focus : 'tur dan transportasi'}. Tanggal: ... Jumlah peserta: ... Lokasi: ...`)}`;
const related = page.related.map(path => indonesianPages.find(item => item.path === path)!);
const schema = {
  '@context': 'https://schema.org', '@graph': [
    { '@type': 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: page.title, description: page.description, inLanguage: 'id', dateModified: indonesiaUpdated, isPartOf: { '@id': new URL('/#website', Astro.site).href }, about: { '@id': new URL('/#business', Astro.site).href }, ...(page.kind === 'service' ? { mainEntity: { '@type': 'Service', name: page.focus, provider: { '@id': new URL('/#business', Astro.site).href }, areaServed: ['Lovina', 'Singaraja', 'Bali Utara'] } } : {}) },
    ...(article ? [{ '@type': 'BlogPosting', headline: page.heading, description: page.description, mainEntityOfPage: { '@id': `${canonical}#webpage` }, inLanguage: 'id', image: new URL(page.image, Astro.site).href, dateModified: indonesiaUpdated, publisher: { '@id': new URL('/#business', Astro.site).href }, author: { '@type': 'Organization', '@id': new URL('/#business', Astro.site).href, name: 'Utami Mesari Tours' } }] : []),
    ...(!home ? [{ '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Beranda', item: new URL('/id/', Astro.site).href }, { '@type': 'ListItem', position: 2, name: page.heading, item: canonical }] }] : []),
  ],
};
const gallery: Record<string, { src: string; alt: string }[]> = {
  dolphins: [{ src: '/images/dolphin-journey.png', alt: 'Gambaran perjalanan perahu di laut Lovina' }, { src: '/images/lovina-sunrise.png', alt: 'Perahu tradisional di laut saat matahari terbit' }],
  'family-transport': [{ src: '/images/family-transport.webp', alt: 'Mobil keluarga sebagai gambaran transportasi' }, { src: '/images/family-transport-pickup.webp', alt: 'Kendaraan untuk gambaran penjemputan keluarga' }],
  'group-transport': [{ src: '/images/group-transport.webp', alt: 'Dua kendaraan untuk gambaran transportasi rombongan' }, { src: '/images/group-transport-red.webp', alt: 'Kendaraan merah sebagai gambaran perjalanan rombongan' }],
};
---
<BaseLayout title={page.title} description={page.description} image={page.image} imageAlt={page.alt} article={article}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
  <header class:list={['local-header', { 'over-hero': home }]}>
    <div class="shell local-nav">
      <a class="local-brand" href="/id/"><span class="brand-mark">U</span><span>Utami Mesari Tours<small>Lovina · Bali Utara</small></span></a>
      <nav class="desktop-nav" aria-label="Navigasi utama"><a href="/id/dolphin-tour-lovina/">Dolphin tour</a><a href="/id/transportasi/">Transportasi</a><a href="/id/tur-bali-utara/">Tur Bali Utara</a><a href="/id/blog">Panduan</a></nav>
      <details class="local-menu"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Menu seluler"><a href="/id/">Beranda</a><a href="/id/dolphin-tour-lovina/">Dolphin tour</a><a href="/id/transportasi/">Transportasi</a><a href="/id/tur-bali-utara/">Tur Bali Utara</a><a href="/id/sewa-kendaraan-jangka-panjang/">Sewa jangka panjang</a><a href="/id/gallery">Galeri</a><a href="/id/blog">Panduan</a><a href={quote}>Hubungi Bu Ayu</a></nav></details>
    </div>
  </header>
  <main id="top">
    {home ? <section class="home-hero">
      <img src={page.image} alt={page.alt} fetchpriority="high" width="1536" height="1024" />
      <div class="hero-shade"></div>
      <div class="home-copy shell"><p class="kicker">{page.label}</p><h1>Utami Mesari <span>Tours</span></h1><p>Dolphin tour Lovina, transportasi pribadi,<br/> dan bantuan perjalanan Bali Utara bersama Bu Ayu.</p><a class="button light" href="/id/dolphin-tour-lovina/">Jelajahi tur laut <ArrowRight size={16}/></a></div>
    </section> : <section class="shell local-hero">
      <div><nav class="breadcrumbs" aria-label="Jejak navigasi"><a href="/id/">Beranda</a><span>/</span><span>{article ? 'Panduan perjalanan' : page.label}</span></nav><p class="kicker">{page.label}</p><h1>{page.heading}</h1><p class="lede">{page.description}</p>{page.kind === 'service' && <a class="button" href={quote}>Tanyakan ke Bu Ayu <ArrowUpRight size={16}/></a>}</div>
      <figure><img src={page.image} alt={page.alt} fetchpriority="high"/><figcaption>{page.path === '/tur-bali-utara/' || page.path === '/blog/a-slow-day-in-north-bali' ? 'Gambar ilustrasi, bukan dokumentasi destinasi tertentu.' : 'Gambaran layanan · Konfirmasikan rincian booking Anda.'}</figcaption></figure>
    </section>}
    <section class="answer-band"><div class="shell"><p class="kicker">{home ? 'Rencanakan bersama kami' : 'Gambaran singkat'}</p><p>{page.answer}</p></div></section>
    {page.sections.length > 2 && <nav class="shell contents" aria-label="Isi halaman">{page.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav>}
    <div class:list={['shell local-content', { editorial: article }]}>
      {page.sections.map((section, index) => <section id={section.id} class:list={['local-section', { 'about-section': home && section.id === 'about' }]}>
        <div><p class="kicker">{String(index + 1).padStart(2, '0')} / {page.label}</p><h2>{section.title}</h2></div>
        <div class="section-copy">{section.paragraphs.map(text => <p>{text}</p>)}{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}
          {page.path === '/transportasi/rombongan/' && section.id === 'options' && <div class="table-scroll" role="region" aria-label="Perbandingan kapasitas kendaraan" tabindex="0"><table><caption>Kapasitas berdasarkan informasi layanan; konfirmasi unit dan bagasi.</caption><thead><tr><th scope="col">Kendaraan</th><th scope="col">Penumpang</th><th scope="col">Sopir</th></tr></thead><tbody><tr><th scope="row">Hiace</th><td>Hingga 15</td><td>1</td></tr><tr><th scope="row">Elf</th><td>Hingga 19</td><td>1</td></tr></tbody></table></div>}
          {home && section.id === 'tours' && <a class="text-link" href="/id/dolphin-tour-lovina/">Lihat pilihan dolphin tour <ArrowRight size={16}/></a>}
          {home && section.id === 'transport' && <a class="text-link" href="/id/transportasi/">Cari transportasi yang sesuai <ArrowRight size={16}/></a>}
          {home && section.id === 'destinations' && <a class="text-link" href="/id/tur-bali-utara/">Bicarakan pilihan tur Bali Utara <ArrowRight size={16}/></a>}
          {home && section.id === 'about' && <img class="owner-photo" src="/images/buk-ayu.jpeg" alt="Bu Ayu, pemilik Utami Mesari Tours" loading="lazy" width="908" height="1600"/>}
        </div>
        {page.kind === 'gallery' && <div class="gallery-grid">{gallery[section.id]?.map(photo => <figure><img src={photo.src} alt={photo.alt} loading="lazy"/><figcaption>{photo.alt}. Unit dan fasilitas perlu dikonfirmasi.</figcaption></figure>)}</div>}
      </section>)}
    </div>
    {page.faqs && <section class="shell local-faq" id="questions"><div><p class="kicker">Sebelum memutuskan</p><h2>Pertanyaan yang sering ditanyakan.</h2></div><div>{page.faqs.map(faq => <details><summary>{faq.q}<span aria-hidden="true">+</span></summary><p>{faq.a}</p></details>)}</div></section>}
    {article && <section class="shell sources"><h2>Sumber dan informasi layanan</h2><p>Disusun oleh Utami Mesari Tours. Informasi layanan mengikuti catatan bisnis; rincian perjalanan dikonfirmasi langsung dengan Bu Ayu sebagai pemilik dan kontak booking. Artikel ini tidak diatribusikan sebagai pengalaman pribadi atau ulasan Bu Ayu.</p>{page.path !== '/blog/a-slow-day-in-north-bali' && <p>Untuk prinsip umum pengamatan satwa laut, lihat <a href="https://www.fisheries.noaa.gov/insight/viewing-marine-life" target="_blank" rel="noreferrer">panduan NOAA Fisheries</a>. Rujukan diperiksa 15 November 2026; aturan Amerika Serikat tidak dinyatakan sebagai hukum Indonesia.</p>}<a href="/id/dolphin-tour-lovina/">Lihat informasi layanan dolphin tour</a> · <a href={business.instagramUrl}>Instagram {business.instagramHandle}</a></section>}
    <section class="shell related-section"><p class="kicker">{page.kind === 'index' ? 'Pilih bacaan atau layanan' : 'Lanjutkan rencana Anda'}</p><h2>{page.kind === 'index' ? 'Panduan dan langkah berikutnya.' : 'Yang mungkin Anda perlukan.'}</h2><div class="related-grid">{related.map(item => <a href={idPath(item.path)}>{(home || page.kind === 'index') && <img src={item.image} alt={item.alt} loading="lazy"/>}<div><p class="kicker">{item.label}</p><h3>{item.heading}</h3><p>{item.description}</p><span>Baca selengkapnya <ArrowRight size={16}/></span></div></a>)}</div></section>
    <section class="local-contact" id="quote"><div class="shell"><p class="kicker">Mulai dari satu pesan</p><h2>Ceritakan rencana Anda<br/> kepada Bu Ayu.</h2><p>Kirim tanggal, jumlah peserta, dan kebutuhan perjalanan.<br/> Pilihan layanan dan harga dibicarakan sebelum booking.</p><a class="button light" href={quote}>Hubungi Bu Ayu <ArrowUpRight size={16}/></a><p><a href={business.whatsappUrl}>{business.phone}</a></p><p>Pelayanan dalam bahasa Indonesia dan Inggris.</p></div></section>
    <p class="shell updated">Terakhir diperbarui: <time datetime={indonesiaUpdated}>15 November 2026</time> · Kontak layanan: Bu Ayu, Utami Mesari Tours.</p>
  </main>
  <footer class="local-footer shell"><a class="local-brand" href="/id/">Utami Mesari Tours</a><nav aria-label="Tautan layanan"><a href="/id/dolphin-tour-lovina/">Dolphin tour</a><a href="/id/transportasi/">Transportasi</a><a href="/id/transportasi/sewa-mobil-singaraja/">Sewa mobil</a><a href="/id/transportasi/rombongan/">Rombongan</a><a href="/id/tur-bali-utara/">Tur Bali Utara</a><a href="/id/sewa-kendaraan-jangka-panjang/">Sewa jangka panjang</a><a href="/id/gallery">Galeri</a><a href="/id/blog">Panduan</a><a href={business.instagramUrl}>Instagram</a></nav><p>Lovina · Bali Utara · Indonesia</p></footer>
</BaseLayout>
<style>
  .local-header{position:relative;z-index:30;border-bottom:1px solid var(--line)}.local-nav{min-height:86px;display:flex;align-items:center;justify-content:space-between;gap:2rem}.local-brand{display:flex;gap:.65rem;align-items:center;font-size:.85rem;font-weight:600}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border:1px solid currentColor;border-radius:50%;font-size:1rem}.local-brand small{display:block;font-size:.58rem;font-weight:400;letter-spacing:.1em;text-transform:uppercase;margin-top:.3rem}.desktop-nav{display:flex;gap:1.8rem;font-size:.76rem}.desktop-nav a:hover{text-decoration:underline;text-underline-offset:6px}.over-hero{position:absolute;inset:0 0 auto;color:white;border-color:#ffffff40}.local-menu{display:none}.home-hero{min-height:100svh;position:relative;display:grid;place-items:center;text-align:center;color:white;background:var(--ink)}.home-hero>img{position:absolute;inset:0;height:100%;object-fit:cover}.hero-shade{position:absolute;inset:0;background:linear-gradient(#102d3340,#102d3325 40%,#102d3355)}.home-copy{position:relative;padding:9rem 1rem 7rem}.home-copy .kicker{color:white}.home-copy h1{font-size:clamp(3.7rem,8vw,7.7rem);line-height:.98;letter-spacing:-.065em;font-weight:400;margin:2rem 0}.home-copy h1 span{display:block}.home-copy>p:not(.kicker){font-size:clamp(1rem,1.7vw,1.2rem);line-height:1.8;margin:0 auto 2rem;max-width:48ch}.light{background:var(--white);color:var(--ink);border-color:white}.light:hover{background:var(--mist);color:var(--ink)}.local-hero{padding-block:3rem 5rem;display:grid;grid-template-columns:1.05fr .95fr;gap:4rem;align-items:center}.breadcrumbs{display:flex;flex-wrap:wrap;gap:.5rem;font-size:.65rem;color:var(--muted);margin-bottom:3.5rem}.local-hero h1{font-size:clamp(2.5rem,4.6vw,4.6rem);line-height:1.1;letter-spacing:-.05em;font-weight:400;margin:1.3rem 0}.local-hero .lede{font-size:1rem;max-width:50ch}.local-hero figure{margin:0}.local-hero img{height:520px;object-fit:cover;border-radius:1rem}figcaption{font-size:.67rem;line-height:1.7;color:var(--muted);margin-top:.6rem}.answer-band{background:var(--mist);padding:2.8rem 0}.answer-band>.shell{display:grid;grid-template-columns:1fr 2fr;gap:3rem}.answer-band p:last-child{font-size:clamp(1.1rem,1.8vw,1.4rem);line-height:1.8;margin:0;max-width:65ch}.contents{display:flex;flex-wrap:wrap;gap:.8rem 1.6rem;padding-block:2rem;border-bottom:1px solid var(--line);font-size:.74rem}.contents a{line-height:1.8;text-decoration:underline;text-underline-offset:4px}.local-section{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,7vw,7rem);padding-block:4.5rem;border-bottom:1px solid var(--line);scroll-margin-top:2rem}h2{font-size:clamp(1.9rem,3.4vw,3rem);line-height:1.18;font-weight:400;letter-spacing:-.04em;margin:1rem 0 1.5rem}.section-copy>p,.section-copy li,.sources p{font-size:1rem;line-height:1.9;color:#425d5f;margin:0 0 1.2rem}.section-copy ul{list-style:disc;padding-left:1.3rem;margin:1.4rem 0 0}.section-copy li{padding-left:.35rem}.text-link{display:inline-flex;align-items:center;gap:.75rem;border-bottom:1px solid var(--line);padding-bottom:.5rem;font-size:.82rem;margin-top:1rem}.owner-photo{max-width:320px;height:400px;object-fit:cover;object-position:50% 20%;margin-top:2rem;border-radius:1rem}.table-scroll{overflow-x:auto;margin-top:2rem}table{width:100%;border-collapse:collapse;font-size:.85rem;text-align:left}caption{text-align:left;line-height:1.7;font-size:.7rem;color:var(--muted);padding-bottom:1rem}th,td{padding:1rem;border-bottom:1px solid var(--line)}thead{background:var(--mist)}.local-faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,7vw,7rem);padding-block:5rem}.local-faq details{border-bottom:1px solid var(--line)}.local-faq summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:1rem;list-style:none;min-height:80px;padding:1rem 0;font-size:1rem;line-height:1.7}.local-faq summary::-webkit-details-marker{display:none}.local-faq summary span{font-size:1.5rem}.local-faq details[open] summary span{transform:rotate(45deg)}.local-faq details p{color:var(--muted);font-size:.95rem;line-height:1.9;margin:0 0 1.5rem}.sources{padding-block:3rem;border-bottom:1px solid var(--line)}.sources h2{font-size:1.4rem}.sources p{max-width:85ch;font-size:.85rem}.sources a{text-decoration:underline;text-underline-offset:4px;font-size:.85rem}.related-section{padding-block:5rem}.related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.2rem;margin-top:2.5rem}.related-grid>a{border:1px solid var(--line);border-radius:1rem;overflow:hidden;background:white;display:flex;flex-direction:column;transition:transform .25s}.related-grid>a:hover{transform:translateY(-4px)}.related-grid img{height:220px;object-fit:cover}.related-grid>a>div{padding:1.5rem;display:flex;flex-direction:column;flex:1}.related-grid h3{font-size:1.35rem;font-weight:500;line-height:1.35;letter-spacing:-.025em;margin:1rem 0}.related-grid p:not(.kicker){font-size:.82rem;line-height:1.8;color:var(--muted);margin:0 0 1.5rem}.related-grid span{display:flex;align-items:center;gap:.75rem;margin-top:auto;font-size:.74rem;padding-top:1rem;border-top:1px solid var(--line)}.local-contact{padding-block:5rem;background:var(--ink);color:white;text-align:center}.local-contact .kicker{color:#bfd7d3}.local-contact h2{font-size:clamp(2.5rem,5vw,4.7rem)}.local-contact p:not(.kicker){line-height:1.9;color:#d0dfdc;font-size:.92rem}.local-contact .button{margin:.8rem 0}.updated{font-size:.7rem;line-height:1.9;color:var(--muted);padding-block:1.7rem}.local-footer{padding-block:2rem 5rem;border-top:1px solid var(--line)}.local-footer nav{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;margin:2rem 0;font-size:.74rem}.local-footer>p{font-size:.65rem;color:var(--muted)}.gallery-grid{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}.gallery-grid figure{margin:0}.gallery-grid img{height:400px;object-fit:cover;border-radius:.8rem}.editorial{max-width:900px}.editorial .local-section{grid-template-columns:1fr;gap:.8rem;padding-block:3rem}.editorial .local-section .kicker{display:none}.editorial h2{max-width:30ch}
  @media(max-width:850px){.desktop-nav{gap:1rem;font-size:.68rem}.local-hero{gap:2rem}.local-hero img{height:440px}.related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.local-section,.local-faq{gap:2rem;grid-template-columns:1fr 1.3fr}}
  @media(max-width:650px){.desktop-nav{display:none}.local-nav{min-height:76px}.local-menu{display:block}.local-menu summary{cursor:pointer;list-style:none;padding:1rem 0 1rem 1rem;font-size:.8rem;display:flex;gap:.8rem}.local-menu summary::-webkit-details-marker{display:none}.local-menu nav{position:absolute;top:76px;left:0;right:0;padding:1.5rem;background:var(--paper);color:var(--ink);display:grid;gap:.3rem;border-bottom:1px solid var(--line);box-shadow:0 8px 20px #15383b15}.local-menu nav a{padding:.7rem 0;font-size:.95rem}.local-hero{grid-template-columns:1fr;padding-block:2rem 3rem}.breadcrumbs{margin-bottom:2rem}.local-hero h1{font-size:clamp(2.3rem,8.5vw,3.4rem)}.local-hero img{height:350px}.home-copy h1{font-size:clamp(3.3rem,13vw,5rem)}.home-copy>p br{display:none}.home-hero{min-height:710px;min-height:100svh}.home-hero>img{object-position:55% center}.answer-band>.shell{grid-template-columns:1fr;gap:1.2rem}.local-section,.local-faq{grid-template-columns:1fr;gap:1rem;padding-block:3rem}.local-section h2{margin-top:.8rem}.section-copy>p,.section-copy li{font-size:.95rem}.related-grid{grid-template-columns:1fr}.related-section{padding-block:3.5rem}.gallery-grid{grid-template-columns:1fr}.gallery-grid img{height:320px}.local-contact br{display:none}.local-contact h2{max-width:15ch;margin-inline:auto}.local-contact{padding-inline:.5rem}.contents{gap:.7rem 1rem}.local-brand{font-size:.75rem}}
  @media(prefers-reduced-motion:reduce){.related-grid>a{transition:none}.related-grid>a:hover{transform:none}}
</style>
